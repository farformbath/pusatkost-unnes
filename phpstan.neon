includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    excludePaths:
        - database/migrations/*_create_permission_tables.php

    bootstrapFiles:
        - tests/phpstan-bootstrap.php

    # Level max is the highest level of static analysis
    level: max

    ignoreErrors: []
